OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# Opcional — só necessário se o `gh` CLI não estiver instalado/autenticado.
# Usado como fallback REST para falar com a API do GitHub (modo --pr).
GITHUB_TOKEN=

# Quantas chamadas LLM da Camada 2 rodam em paralelo (default 5).
LLM_MAX_CONCURRENCY=5
